# Google OAuth2 Client ID from https://console.cloud.google.com/apis/credentials
# Must match the GOOGLE_CLIENT_ID in frontend/src/auth.ts
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# HTTP port for the backend server (default: 8080)
PORT=8080

# Additional allowed CORS origin for production (optional)
# ALLOWED_ORIGIN=https://your-production-domain.com
